# .env.example
# DNA Assistant Environment Configuration Example

GOOGLE_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# MCP / Direct SDK Tool Credentials
APIFY_API_KEY=your_apify_api_token_here
COMPOSIO_API_KEY=your_composio_api_key_here

# Daily Usage Hard Limits (Enforced by core/usage_tracker.py)
APIFY_DAILY_LIMIT=50
COMPOSIO_DAILY_LIMIT=20
